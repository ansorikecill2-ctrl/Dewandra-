      font-size: 25px;
    }

    .bio {
      margin-top: 10px;
      color: #d1d5db;
      line-height: 1.6;
    }

    .tombol {
      display: block;
      text-decoration: none;
      color: white;
      background: #2563eb;
      padding: 15px;
      margin-top: 15px;
      border-radius: 14px;
      font-weight: bold;
    }

    .tombol:hover {
      background: #1d4ed8;
    }

    .wa {
      background: #16a34a;
    }

    .footer {
      margin-top: 25px;
      font-size: 12px;
      color: #9ca3af;
    }
  </style>
</head>

